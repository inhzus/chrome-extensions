{
  "manifest_version": 3,
  "name": "V2EX Inn",
  "version": "0.2.1",
  "description": "Personal user tags, pinned hot replies and auto daily check-in for V2EX.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.v2ex.com/*", "https://v2ex.com/*", "https://*.v2ex.com/*"],
      "js": ["src/storage.js", "src/tags.js", "src/hot.js", "src/checkin.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
